<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane layoutX="1.0" prefHeight="453.0" prefWidth="247.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.andy.linearj.Screen.controllers.MatrixCalculatorUnitController">
    <Label alignment="CENTER" layoutY="6.0" prefHeight="17.0" prefWidth="253.0" text="Matrix Input &amp; Calculator" />

    <VBox layoutX="22.0" layoutY="215.0" prefHeight="158.0" prefWidth="85.0" spacing="30.0">
        <Button mnemonicParsing="false" onAction="#addMatricesClick" prefHeight="26.0" prefWidth="85.0" stylesheets="@CSSStyleSheets/buttons.css" text="ADD">
            <styleClass>
                <String fx:value="button_main" />
                <String fx:value="button-primary" />
            </styleClass>
        </Button>
        <Button mnemonicParsing="false" onAction="#subtractMatricesClick" prefHeight="26.0" prefWidth="85.0" stylesheets="@CSSStyleSheets/buttons.css" text="SUB">
            <styleClass>
                <String fx:value="button_main" />
                <String fx:value="button-primary" />
            </styleClass>
        </Button>
        <Button mnemonicParsing="false" onAction="#multiplyMatricesClick" prefHeight="26.0" prefWidth="85.0" stylesheets="@CSSStyleSheets/buttons.css" text="MULT">
            <styleClass>
                <String fx:value="button_main" />
                <String fx:value="button-primary" />
            </styleClass>
        </Button>
    </VBox>

    <VBox layoutX="134.0" layoutY="215.0" prefHeight="158.0" prefWidth="85.0" spacing="30.0">
        <Button mnemonicParsing="false" onAction="#computeInversionClick" prefHeight="26.0" prefWidth="92.0" stylesheets="@CSSStyleSheets/buttons.css" text="INVERT">
            <styleClass>
                <String fx:value="button_main" />
                <String fx:value="button-primary" />
            </styleClass>
        </Button>
        <Button mnemonicParsing="false" onAction="#computeDeterminantClick" prefHeight="26.0" prefWidth="88.0" stylesheets="@CSSStyleSheets/buttons.css" text="DET">
            <styleClass>
                <String fx:value="button_main" />
                <String fx:value="button-primary" />
            </styleClass>
        </Button>
        <Button disable="true" mnemonicParsing="false" onAction="#transposeMatrixClick" prefHeight="26.0" prefWidth="89.0" stylesheets="@CSSStyleSheets/buttons.css" text="A^T">
            <styleClass>
                <String fx:value="button_main" />
                <String fx:value="button-primary" />
            </styleClass>
            <font>
                <Font size="10.0" />
            </font>
        </Button>
    </VBox>

    <HBox alignment="CENTER" layoutX="17.0" layoutY="393.0" prefHeight="57.0" prefWidth="205.0" spacing="30.0">
      <children>
           <Button alignment="CENTER" mnemonicParsing="false" onAction="#clearInputField" prefHeight="26.0" prefWidth="80.0" stylesheets="@CSSStyleSheets/buttons.css" text="CLEAR">
               <styleClass>
                   <String fx:value="button_main" />
                   <String fx:value="button-primary" />
               </styleClass>
           </Button>
           <Button alignment="CENTER" mnemonicParsing="false" onAction="#openHelpWindow" prefHeight="26.0" prefWidth="75.0" stylesheets="@CSSStyleSheets/buttons.css" text="HELP">
               <styleClass>
                   <String fx:value="button_main" />
                   <String fx:value="button-primary" />
               </styleClass>
           </Button>
      </children></HBox>

    <TextArea fx:id="matrixInputTextArea" layoutX="14.0" layoutY="31.0" prefHeight="168.0" prefWidth="230.0" promptText="Please type in your matrix using the correct formatting." wrapText="true">
        <cursor>
            <Cursor fx:constant="DEFAULT" />
        </cursor>



    </TextArea>

</AnchorPane>
